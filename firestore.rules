rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidTransaction(data, userId) {
      return data.userId == userId
        && data.userId == request.auth.uid
        && (data.type == 'income' || data.type == 'expense')
        && (data.amount is number || data.amount is int)
        && data.amount > 0
        && data.amount <= 1000000000
        && data.category is string
        && data.category.size() > 0
        && data.category.size() <= 64
        && data.date is string
        && data.date.size() == 10
        && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && (!('note' in data) || (data.note is string && data.note.size() <= 300))
        && (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 32));
    }

    function isValidUserProfile(data, userId) {
      return data.email is string
        && data.email.size() <= 256
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512));
    }

    // User profile document
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create, update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow delete: if isOwner(userId) && isValidId(userId);

      // Subcollection for user transactions
      match /transactions/{transactionId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(transactionId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(transactionId);
        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(transactionId)
          && isValidTransaction(incoming(), userId);
        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(transactionId)
          && isValidTransaction(incoming(), userId)
          && incoming().userId == existing().userId;
      }
    }
  }
}
